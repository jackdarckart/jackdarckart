<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <title>Login.js</title>
    <style type="text/css">
        .login-form {
            max-width: 500px;
            margin: 20px auto;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        .form-control {
            width: 100%;
            padding: 15px;
            border: 1px solid #eee;
            border-radius: 4px;
            font-size: 14px !important;
            transition: all 0.3s ease;
        }
        
        .login-form input[type="email"] {
            margin-right: 10px;
            padding-left: 10px;
            border: 1px solid transparent;
            border-radius: 50%;
        }
        
        .login-form input[type="password"] {
            margin-bottom: 15px;
            border: 1px solid #eee;
            border-radius: 4px !important;
        }
        
        .btn {
            width: 100%;
            padding: 12px;
            background-color: #2d3748;
            color: white;
            text-decoration: none;
            border-radius: 50%;
            transition: all 0.3s ease;
        }
        
        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.15);
        }
        
        .form-group input {
            border: none;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
        
        .neon-form-control:focus {
            outline: none;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.2);
        }
        
        .border {
            solid: 1px #ddd;
            margin: 2px;
        }
    </style>
</head>
<body>
    <div class="login-form">
        <form id="login-form">
            <div class="form-control" style="display: none;">
                Email: <br>
                Password: 
            </div>

            <form onSubmit="resetGameData()">
                <button type="submit">
                    Login
                </button>
            </form>
        </form>
    </div>

    <script>
        // Game data loading function
        async function loadGameObjects() {
            try {
                const gameObjects = JSON.parse(localStorage.getItem('gameObjects'));
                
                if (!gameObjects.length) return;  // No games loaded, just submit the login form

                // Login functionality
                document.getElementById('login-form').reset();
                
                // Game area creation
                for (let gameId in gameObjects) {
                    const gameData = JSON.parse(gameObjects[gameId]);
                    
                    const cell = document.createElement('div');
                    cell.className = 'neon-form-control';
                    cell.innerHTML = `
                        <div class="cell border" style="display: none;">
                            ${gameData['name']} - ${gameData['level']} |
                            ${gameData['language']}: ${gameData['gameType']}
                        </div>
                    `;
                    
                    // Buttons if needed
                    if (gameData['beats']) {
                        const incrementBtn = document.createElement('button');
                        incrementBtn.className = 'btn';
                        incrementBtn.textContent = `+1 Beat/s`;
                        cell.appendChild(incrementBtn);
                    }
                    
                    if (gameData['score']) {
                        const scoreBtn = document.createElement('button');
                        scoreBtn.className = 'btn';
                        scoreBtn.textContent = '0';
                        cell.appendChild(scoreBtn);
                    }
                    
                    if (gameData['gameAction']) {
                        const actionBtn = document.createElement('button');
                        actionBtn.className = 'btn';
                        actionBtn.textContent = 'Set Action';
                        cell.appendChild(actionBtn);
                    }
                }

                // Login form
                document.getElementById('login-form').reset();
                
                // Game data submission
                async function resetGameData() {
                    localStorage.setItem('gameObjects', gameObjects);
                    document.getElementById('login-form').reset();
                }

                const container = document.getElementById('game-container');
                container.innerHTML = gameObjects.join('');
            } catch (error) {
                console.error('Error loading game objects:', error);
            }
        }
    </script>
</body>
</html>
